# ============================================
# Configuración del Secuenciador EVM
# ============================================

# ============================================
# Puertos de métricas Prometheus
# ============================================

SEQUENCER_EV_RETH_PROMETHEUS_PORT="9000"
SEQUENCER_EV_NODE_PROMETHEUS_PORT="26660"

# ============================================
# Namespaces de DA (¡DEBEN COINCIDIR CON stacks/da-celestia/.env!)
# ============================================
# Estos valores deben ser los mismos que configuraste en da-celestia/.env
# El secuenciador usa estos namespaces para publicar bloques en Celestia.

SEQUENCER_DA_HEADER_NAMESPACE="0x00000000000000000000000000000000000000000XXXXXXXXXXXXXXXX"
SEQUENCER_DA_DATA_NAMESPACE="0x00000000000000000000000000000000000000000XXXXXXXXXXXXXXXX"

# ============================================
# Configuración de la blockchain EVM
# ============================================

# ID de la cadena (usa un valor único para tu red)
CHAIN_ID="1234"

# Altura de inicio de DA (debe coincidir con DA_TRUSTED_HEIGHT en da-celestia/.env)
SEQUENCER_DA_START_HEIGHT="XXXXXXX"
