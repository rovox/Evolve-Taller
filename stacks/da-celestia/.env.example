# ============================================
# Configuración de Celestia DA
# ============================================

# Endpoint del Core RPC de Celestia (público para testnet Mocha)
DA_CORE_IP="rpc-mocha.pops.one"
DA_CORE_PORT="9090"

# ============================================
# Namespaces de DA (¡GENERA TUS PROPIOS VALORES!)
# ============================================
# Los namespaces identifican tu aplicación en Celestia DA.
# IMPORTANTE: Estos valores son únicos para tu deployment.
# 
# Para generar namespaces:
# 1. Usa la herramienta de Celestia: https://docs.celestia.org/developers/namespace
# 2. O genera valores aleatorios con formato hexadecimal de 29 bytes
#
# Formato: 0x + 58 caracteres hexadecimales
# Ejemplo: 0x00000000000000000000000000000000000000000123456789abcdef012345

DA_HEADER_NAMESPACE="0x00000000000000000000000000000000000000000XXXXXXXXXXXXXXXX"
DA_DATA_NAMESPACE="0x00000000000000000000000000000000000000000XXXXXXXXXXXXXXXX"

# ============================================
# Punto de sincronización confiable (Trusted Sync)
# ============================================
# Estos valores se usan para sincronización rápida con un punto conocido.
# Obtén valores actuales desde:
# - https://docs.celestia.org/nodes/light-node#sync-from-trusted-hash
# - O consulta un explorador de Celestia: https://mocha.celenium.io/

DA_TRUSTED_HEIGHT="XXXXXXX"
DA_TRUSTED_HASH="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ============================================
# Configuración de red
# ============================================

# Red de Celestia (mocha = testnet, arabica = devnet, mainnet = producción)
DA_NETWORK="mocha"

# Puerto local para el RPC del light node
DA_RPC_PORT="26658"
