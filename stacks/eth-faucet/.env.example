# ============================================
# Configuración del Faucet de Ethereum
# ============================================

# ============================================
# Clave Privada (¡GENERA UNA CLAVE SEGURA!)
# ============================================
# Esta clave privada se usa para firmar transacciones del faucet.
# ADVERTENCIA: Nunca uses una clave que contenga fondos reales.
#
# Para generar una nueva clave privada:
# 1. Usa una wallet como MetaMask y crea una cuenta nueva
# 2. Exporta la clave privada
# 3. O genera una con: cast wallet new (requiere foundry)
#
# Formato: 0x + 64 caracteres hexadecimales

PRIVATE_KEY="0xTU_CLAVE_PRIVADA_AQUI_64_CARACTERES_HEXADECIMALES"

# ============================================
# Configuración del servidor
# ============================================

# Puerto local donde se expondrá el faucet
ETH_FAUCET_PORT="8081"

# ============================================
# Notas de seguridad
# ============================================
# - El faucet debe conectarse al nodo RPC local (ev-reth-sequencer:8545)
# - La cuenta asociada debe tener fondos suficientes en tu blockchain local
# - Puedes fondear la cuenta desde el genesis o mediante minería inicial
