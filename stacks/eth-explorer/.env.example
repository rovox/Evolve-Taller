# ============================================
# Configuración del Explorador Blockscout
# ============================================

# ============================================
# Configuración de Blockchain
# ============================================

# ID de la cadena (debe coincidir con el secuenciador)
CHAIN_ID="1234"

# ============================================
# Configuración de Base de Datos
# ============================================

# Contraseña de PostgreSQL (¡GENERA UNA CONTRASEÑA SEGURA!)
# Puedes generarla con: openssl rand -hex 16
EXPLORER_POSTGRES_PASSWORD="TU_CONTRASEÑA_SEGURA_AQUI"

# ============================================
# Hosts de Servicios (normalmente no necesitan cambios)
# ============================================

EXPLORER_DB_HOST=blockscout-db
EXPLORER_DB_PORT="5432"
EXPLORER_BACKEND_HOST=blockscout-backend
EXPLORER_STATS_HOST=stats
EXPLORER_STATS_DB_HOST=stats-db
EXPLORER_STATS_DB_PORT="5432"
EXPLORER_REDIS_HOST=blockscout-redis
EXPLORER_FRONTEND_PORT="3000"

# ============================================
# Configuración de RPC
# ============================================

# Host del nodo Reth (normalmente el nombre del contenedor)
RETH_HOST=ev-reth-sequencer
RETH_HOST_HTTP_PORT="8545"
RETH_HOST_WS_PORT="8546"

# ============================================
# Configuración de Seguridad
# ============================================

# Clave secreta para Phoenix Framework (¡GENERA UNA CLAVE ÚNICA!)
# Genera con: openssl rand -base64 64
SECRET_KEY_BASE="TU_SECRET_KEY_BASE_AQUI_GENERADO_CON_OPENSSL"
